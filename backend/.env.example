PORT=9080
MONGODB_URI=mongodb://127.0.0.1:27017/saferoute
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# --- AI (Gemini, free tier) ---
GEMINI_API_KEY=your_google_ai_studio_api_key
# Tried in order; each model has its own free quota, so the 2nd is a safety net.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Hard daily cap on Gemini calls. Keep it below your real free limit.
GEMINI_DAILY_LIMIT=60

# --- Extra free news sources (all optional; Google News RSS needs no key) ---
# https://gnews.io  (free: 100 requests/day)
GNEWS_API_KEY=
GNEWS_DAILY_LIMIT=80
# https://newsdata.io  (free: 200 credits/day)
NEWSDATA_API_KEY=
NEWSDATA_DAILY_LIMIT=150

# --- Community admin ---
# Accounts with these emails can verify/reject places & reports (comma separated).
ADMIN_EMAILS=

# --- Demo helpers ---
AUTO_SEED=true          # load the demo dataset when the database is empty
AUTO_FETCH_ROADS=true   # trace exact road shapes from OpenStreetMap on startup
